{
  "name": "herdr-codex-controller",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A thin Codex-first release delivery controller for ordered GitHub issues.",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "herdr-codex": "./dist/src/cli.js"
  },
  "scripts": {
    "contract:check": "node scripts/generate-runtime-contract-lock.mjs",
    "contract:generate": "node scripts/generate-runtime-contract-lock.mjs --write",
    "history:check": "node scripts/generate-controller-identity-history.mjs",
    "history:generate": "node scripts/generate-controller-identity-history.mjs --write",
    "history:append": "node scripts/append-controller-identity-history.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/src/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "verify": "npm run typecheck && npm run test && npm run history:check && npm run contract:check"
  },
  "devDependencies": {
    "@openai/codex": "0.147.0",
    "ajv": "8.20.0",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
