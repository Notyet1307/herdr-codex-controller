{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Controller identity history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "digestAlgorithm", "entries", "digest"],
  "properties": {
    "schema": { "const": "herdr-codex-controller:identity-history:v1" },
    "version": { "const": 1 },
    "digestAlgorithm": { "const": "utf16-code-unit-canonical-json-v1+sha256-hex" },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "ownedSchemas", "qualificationStatus", "activatedAt", "revocation"],
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "sourceRevision", "sourceManifestDigest", "buildDigest", "digest"],
            "properties": {
              "version": { "const": 1 },
              "sourceRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
              "sourceManifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "buildDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "ownedSchemas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["schema", "sha256"],
              "properties": {
                "schema": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
              }
            }
          },
          "qualificationStatus": { "const": "qualified" },
          "activatedAt": { "type": "string", "format": "date-time" },
          "revocation": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["revokedAt", "reason"],
                "properties": {
                  "revokedAt": { "type": "string", "format": "date-time" },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 2000 }
                }
              }
            ]
          }
        }
      }
    },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
