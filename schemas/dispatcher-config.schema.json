{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Issue Dispatcher Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "parentIssue",
    "readyLabel",
    "releaseAcceptanceCriteria",
    "reviewFocus",
    "postMerge"
  ],
  "properties": {
    "version": { "const": 1 },
    "parentIssue": { "type": "integer", "minimum": 1 },
    "readyLabel": { "const": "ready-for-agent" },
    "releaseAcceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "reviewFocus": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "postMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredWorkflows", "pollIntervalMs", "timeoutMs"],
      "properties": {
        "requiredWorkflows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "pollIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "timeoutMs": { "type": "integer", "minimum": 60000, "maximum": 86400000 }
      }
    }
  }
}
