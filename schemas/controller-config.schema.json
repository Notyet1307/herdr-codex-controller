{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Controller Config v2 with explicit v1 compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "localPath", "stateDir", "worktreeRoot", "baseRef", "remote", "branchPrefix", "shell", "codex", "validation", "policy", "review", "delivery"],
  "properties": {
    "version": { "enum": [1, 2] },
    "executionMode": {
      "enum": ["release-plan-v2-direct", "release-plan-v1-compatibility", "dispatcher-experimental"],
      "default": "release-plan-v2-direct",
      "description": "Qualified production uses release-plan-v2-direct. Release Plan v1 and Dispatcher require explicit non-production modes."
    },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "localPath": { "type": "string", "minLength": 1 },
    "stateDir": { "type": "string", "minLength": 1 },
    "worktreeRoot": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1 },
    "remote": { "type": "string", "minLength": 1 },
    "remoteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fetchUrl", "pushUrl"],
      "properties": {
        "version": { "const": 1 },
        "fetchUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pushUrl": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "branchPrefix": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin", "workerProfile", "reviewerProfile", "workerTimeoutMs", "reviewerTimeoutMs", "terminationGraceMs", "networkAccess"],
      "properties": {
        "bin": { "type": "string", "minLength": 1 },
        "workerProfile": { "type": ["string", "null"] },
        "reviewerProfile": { "type": ["string", "null"] },
        "workerTimeoutMs": { "type": "integer", "minimum": 60000 },
        "reviewerTimeoutMs": { "type": "integer", "minimum": 60000 },
        "terminationGraceMs": { "type": "integer", "minimum": 1000 },
        "maxEventBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "maxStderrBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "maxResultBytes": { "type": "integer", "minimum": 4096, "maximum": 4194304 },
        "maxAggregateBytes": { "type": "integer", "minimum": 4096, "maximum": 33554432 },
        "networkAccess": { "const": false }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "issue", "release", "maxOutputBytes"],
      "properties": {
        "setup": { "$ref": "#/$defs/commands" },
        "issue": { "$ref": "#/$defs/commands" },
        "release": { "$ref": "#/$defs/commands" },
        "maxOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxStdoutBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxStderrBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxAggregateBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "provider", "bin", "root", "environmentPath"],
          "properties": {
            "version": { "const": 1 },
            "provider": { "const": "codex-permission-profile" },
            "bin": { "type": "string", "pattern": "^/" },
            "root": { "type": "string", "pattern": "^/" },
            "environmentPath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIssueRepairRounds", "maxReleaseHardeningRounds", "maxCiRepairRounds", "maxIssues", "maxChangedFiles", "maxChangedLines"],
      "properties": {
        "maxIssueRepairRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxReleaseHardeningRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxCiRepairRounds": { "type": "integer", "minimum": 0, "maximum": 1 },
        "maxIssues": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxChangedFiles": { "type": "integer", "minimum": 1 },
        "maxChangedLines": { "type": "integer", "minimum": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "blockingSeverities"],
      "properties": {
        "enabled": { "type": "boolean" },
        "blockingSeverities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["critical", "major"] }
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createPullRequest", "draft", "autoMerge", "mergeMethod", "allowNoChecks", "requiredChecks", "pollIntervalMs"],
      "properties": {
        "createPullRequest": { "type": "boolean" },
        "draft": { "type": "boolean" },
        "autoMerge": { "type": "boolean" },
        "mergeMethod": { "enum": ["merge", "squash", "rebase"] },
        "allowNoChecks": { "type": "boolean" },
        "requiredChecks": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "pollIntervalMs": { "type": "integer", "minimum": 1000 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } }, "required": ["version"] },
      "then": {
        "required": ["executionMode"],
        "properties": {
          "executionMode": { "enum": ["release-plan-v1-compatibility", "dispatcher-experimental"] },
          "validation": {
            "not": {
              "anyOf": [
                { "required": ["sandbox"] },
                { "required": ["maxStdoutBytes"] },
                { "required": ["maxStderrBytes"] },
                { "required": ["maxAggregateBytes"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "version": { "const": 2 } }, "required": ["version"] },
      "then": {
        "required": ["remoteIdentity"],
        "properties": {
          "codex": {
            "required": ["bin", "workerProfile", "reviewerProfile", "workerTimeoutMs", "reviewerTimeoutMs", "terminationGraceMs", "maxEventBytes", "maxStderrBytes", "maxResultBytes", "maxAggregateBytes", "networkAccess"]
          },
          "validation": {
            "required": ["setup", "issue", "release", "maxOutputBytes", "maxStdoutBytes", "maxStderrBytes", "maxAggregateBytes", "sandbox"]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          { "required": ["executionMode"], "properties": { "executionMode": { "const": "release-plan-v2-direct" } } },
          { "not": { "required": ["executionMode"] } }
        ]
      },
      "then": {
        "properties": {
          "codex": {
            "properties": {
              "bin": { "pattern": "^/" },
              "workerProfile": { "const": null },
              "reviewerProfile": { "const": null }
            }
          },
          "delivery": {
            "properties": {
              "createPullRequest": { "const": true },
              "allowNoChecks": { "const": false },
              "requiredChecks": { "minItems": 1 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "timeoutMs": { "type": "integer", "minimum": 1000 }
            }
          }
        ]
      }
    }
  }
}
