{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Controller production config v4",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repo", "localPath", "stateDir", "worktreeRoot", "baseRef", "remote", "remoteIdentity", "branchPrefix", "shell", "codex", "validation", "policy", "delivery"],
  "properties": {
    "version": { "const": 4 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "localPath": { "type": "string", "minLength": 1 },
    "stateDir": { "type": "string", "minLength": 1 },
    "worktreeRoot": { "type": "string", "minLength": 1 },
    "baseRef": { "type": "string", "minLength": 1 },
    "remote": { "type": "string", "minLength": 1 },
    "remoteIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fetchUrl", "pushUrl"],
      "properties": {
        "version": { "const": 1 },
        "fetchUrl": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "pushUrl": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "branchPrefix": { "type": "string", "minLength": 1 },
    "shell": { "type": "string", "minLength": 1 },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bin", "workerTimeoutMs", "reviewerTimeoutMs", "terminationGraceMs", "maxEventBytes", "maxStderrBytes", "maxResultBytes", "maxAggregateBytes"],
      "properties": {
        "bin": { "type": "string", "pattern": "^/" },
        "workerTimeoutMs": { "type": "integer", "minimum": 60000 },
        "reviewerTimeoutMs": { "type": "integer", "minimum": 60000 },
        "terminationGraceMs": { "type": "integer", "minimum": 1000 },
        "maxEventBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "maxStderrBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "maxResultBytes": { "type": "integer", "minimum": 4096, "maximum": 4194304 },
        "maxAggregateBytes": { "type": "integer", "minimum": 4096, "maximum": 33554432 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "issue", "release", "maxOutputBytes", "maxStdoutBytes", "maxStderrBytes", "maxAggregateBytes", "sandbox"],
      "properties": {
        "setup": { "$ref": "#/$defs/commands" },
        "issue": { "$ref": "#/$defs/commands" },
        "release": { "$ref": "#/$defs/commands" },
        "maxOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxStdoutBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxStderrBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 },
        "maxAggregateBytes": { "type": "integer", "minimum": 4096, "maximum": 16777216 },
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "provider", "bin", "root", "environmentPath"],
          "properties": {
            "version": { "const": 1 },
            "provider": { "const": "codex-permission-profile" },
            "bin": { "type": "string", "pattern": "^/" },
            "root": { "type": "string", "pattern": "^/" },
            "environmentPath": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxIssueRepairRounds", "maxCodeRepairRounds", "maxInfrastructureReruns", "maxIssues", "maxChangedFiles", "maxChangedLines"],
      "properties": {
        "maxIssueRepairRounds": { "type": "integer", "minimum": 0, "maximum": 2 },
        "maxCodeRepairRounds": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxInfrastructureReruns": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxIssues": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxChangedFiles": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maxChangedLines": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "reviewDemo": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["command", "required", "networkAccess", "timeoutMs", "maxOutputBytes"],
      "properties": {
        "command": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "required": { "type": "boolean" },
        "networkAccess": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 3600000 },
        "maxOutputBytes": { "type": "integer", "minimum": 4096, "maximum": 8388608 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draft", "mergeMethod", "requiredChecks", "pollIntervalMs"],
      "properties": {
        "draft": { "type": "boolean" },
        "mergeMethod": { "enum": ["merge", "squash", "rebase"] },
        "requiredChecks": { "$ref": "#/$defs/requiredCheckContract" },
        "pollIntervalMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    }
  },
  "$defs": {
    "commands": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["command"],
            "properties": {
              "command": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "timeoutMs": { "type": "integer", "minimum": 1000 }
            }
          }
        ]
      }
    },
    "requiredCheckContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "firstAppearanceTimeoutMs", "pendingTimeoutMs", "checks"],
      "properties": {
        "version": { "const": 1 },
        "firstAppearanceTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 604800000 },
        "pendingTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 604800000 },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "contains": { "type": "object", "properties": { "required": { "const": true } }, "required": ["required"] },
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "appId", "workflowName", "acceptedConclusions", "required"],
            "allOf": [
              {
                "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
                "then": {
                  "anyOf": [
                    { "properties": { "appId": { "type": "integer", "minimum": 1 } } },
                    { "properties": { "workflowName": { "type": "string", "minLength": 1 } } }
                  ]
                }
              }
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 500 },
              "appId": { "type": ["integer", "null"], "minimum": 1 },
              "workflowName": { "type": ["string", "null"], "minLength": 1, "maxLength": 500 },
              "acceptedConclusions": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "enum": ["SUCCESS", "NEUTRAL", "SKIPPED"] }
              },
              "required": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
