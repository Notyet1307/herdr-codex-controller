{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pi-ticket-planning.invalid/goal-handoff-v1.schema.json",
  "title": "Planner Goal handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseId", "repo", "baseSha", "planDigest", "channel", "runnerRef", "runnerDigest", "runnerHost", "releasePlan"],
  "properties": {
    "schema": { "const": "pi-ticket-planning:goal-handoff:v1" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "channel": { "enum": ["GOAL_LOCAL", "GOAL_REMOTE"] },
    "runnerRef": { "type": "string", "pattern": "^[a-z0-9._-]{1,80}$" },
    "runnerDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "runnerHost": { "type": "string", "pattern": "^(?!-)[A-Za-z0-9._-]{1,253}$" },
    "releasePlan": {
      "allOf": [
        { "$ref": "release-plan.schema.json" },
        {
          "properties": {
            "issues": {
              "items": { "properties": { "risk": { "enum": ["low", "normal"] } } }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "channel": { "const": "GOAL_LOCAL" } }, "required": ["channel"] },
      "then": { "properties": { "runnerRef": { "const": "local" } } }
    }
  ]
}
