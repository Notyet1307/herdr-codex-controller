{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Release Plan v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "source", "id", "title", "objective", "parentIssue", "issues", "releaseAcceptanceCriteria", "reviewFocus"],
  "properties": {
    "version": { "const": 2 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "repo", "baseRef", "baseSha", "parentBinding", "specContentHash", "deliveryGraphDigest", "decisionManifestDigest", "predecessorReceiptDigest", "dependencyHandoffDigests"],
      "properties": {
        "planner": { "const": "pi-ticket-planning" },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$", "maxLength": 300 },
        "baseRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "pattern": "^[A-Za-z0-9._/-]+$",
          "not": { "pattern": "(^/|/$|//|\\.\\.|@\\{|\\.$|(^|/)\\.|\\.lock($|/)|^@$)" }
        },
        "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "parentBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["number", "expectedTitle", "expectedBodyHash"],
          "properties": {
            "number": { "type": "integer", "minimum": 1 },
            "expectedTitle": { "type": "string", "pattern": "\\S", "maxLength": 500 },
            "expectedBodyHash": { "$ref": "#/$defs/prefixedSha256" }
          }
        },
        "specContentHash": { "$ref": "#/$defs/prefixedSha256" },
        "deliveryGraphDigest": { "$ref": "#/$defs/prefixedSha256" },
        "decisionManifestDigest": { "$ref": "#/$defs/prefixedSha256" },
        "predecessorReceiptDigest": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/prefixedSha256" }
          ]
        },
        "dependencyHandoffDigests": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/prefixedSha256" }
        }
      }
    },
    "id": { "type": "string", "pattern": "\\S", "maxLength": 120 },
    "title": { "type": "string", "pattern": "\\S", "maxLength": 500 },
    "objective": { "type": "string", "pattern": "\\S", "maxLength": 8000 },
    "parentIssue": { "type": "integer", "minimum": 1 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "order", "dependsOn", "objective", "acceptanceCriteria", "suggestedValidation", "allowNoop", "expectedTitle", "expectedBodyHash", "oracleBindings", "riskClasses", "scopeBudget", "expectedPaths", "protectedPaths", "replanTriggers", "integrationOnly", "waiverDigests"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "order": { "type": "integer", "minimum": 1, "maximum": 10000 },
          "dependsOn": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
          "objective": { "type": "string", "pattern": "\\S", "maxLength": 8000 },
          "acceptanceCriteria": {
            "type": "array",
            "minItems": 3,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "\\S", "maxLength": 2000 }
          },
          "suggestedValidation": { "const": [] },
          "allowNoop": { "const": false },
          "expectedTitle": { "type": "string", "pattern": "\\S", "maxLength": 500 },
          "expectedBodyHash": { "$ref": "#/$defs/prefixedSha256" },
          "oracleBindings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/oracleBinding" }
          },
          "riskClasses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }
          },
          "scopeBudget": {
            "type": "object",
            "additionalProperties": false,
            "required": ["maxFiles", "maxChangedLines"],
            "properties": {
              "maxFiles": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "maxChangedLines": { "type": "integer", "minimum": 1, "maximum": 1000000 }
            }
          },
          "expectedPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/expectedPath" }
          },
          "protectedPaths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repoPath" }
          },
          "replanTriggers": {
            "type": "array",
            "minItems": 4,
            "maxItems": 32,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
            "allOf": [
              { "contains": { "const": "ACCEPTED_DECISION_CHANGE_REQUIRED" } },
              { "contains": { "const": "THIRD_RISK_CLASS_DISCOVERED" } },
              { "contains": { "const": "SCOPE_BUDGET_EXCEEDED" } },
              { "contains": { "const": "DOWNSTREAM_RELEASE_BEHAVIOR_DISCOVERED" } }
            ]
          },
          "integrationOnly": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["noNewProductBehavior", "noSchemaChanges", "noDuplicatedProductionLogic", "missingBehavior"],
                "properties": {
                  "noNewProductBehavior": { "const": true },
                  "noSchemaChanges": { "const": true },
                  "noDuplicatedProductionLogic": { "const": true },
                  "missingBehavior": { "const": "REPLAN_REQUIRED" }
                }
              }
            ]
          },
          "waiverDigests": {
            "type": "array",
            "maxItems": 8,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/prefixedSha256" }
          }
        }
      }
    },
    "releaseAcceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S", "maxLength": 2000 }
    },
    "reviewFocus": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "\\S", "maxLength": 2000 }
    }
  },
  "$defs": {
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*[\\\\*?\\[\\]{}\\u0000\\r\\n])[^/]+(?:/[^/]+)*$"
    },
    "expectedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\.\\.?(?:/|$))(?!.*(?:/\\.\\.?)(?:/|$))(?!.*//)(?!.*\\*\\*)(?![^/]*\\*)(?!.*[\\\\?\\[\\]{}\\u0000\\r\\n])[^/]+(?:/[^/]+)*$"
    },
    "oracleBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "owner", "artifact", "execution", "verifier", "workerMutationAllowed"],
      "properties": {
        "schema": { "const": "pi-ticket-planning:oracle-binding:v1" },
        "id": { "type": "string", "pattern": "^O(?:0[1-9][0-9]*|[1-9][0-9]*)$" },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "identity"],
          "properties": {
            "kind": { "const": "INDEPENDENT_VERIFICATION" },
            "identity": { "type": "string", "pattern": "\\S", "maxLength": 256 }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "format", "baseSha", "sha256", "byteCount"],
          "properties": {
            "path": { "$ref": "#/$defs/repoPath" },
            "format": { "type": "string", "pattern": "\\S", "maxLength": 256 },
            "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
            "sha256": { "$ref": "#/$defs/prefixedSha256" },
            "byteCount": { "type": "integer", "minimum": 0, "maximum": 67108864 }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string", "pattern": "^npm run verify:[A-Za-z0-9:_-]+$", "maxLength": 512 }
          }
        },
        "verifier": { "$ref": "#/$defs/oracleVerifierManifest" },
        "workerMutationAllowed": { "const": false }
      }
    },
    "oracleVerifierManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "oracleId", "command", "packageScript", "files", "digest"],
      "properties": {
        "schema": { "const": "herdr-codex-controller:oracle-verifier-manifest:v1" },
        "oracleId": { "type": "string", "pattern": "^O(?:0[1-9][0-9]*|[1-9][0-9]*)$" },
        "command": { "type": "string", "pattern": "^npm run verify:[A-Za-z0-9:_-]+$", "maxLength": 512 },
        "packageScript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "definitionSha256"],
          "properties": {
            "name": { "type": "string", "pattern": "^verify:[A-Za-z0-9:_-]+$", "maxLength": 256 },
            "definitionSha256": { "$ref": "#/$defs/prefixedSha256" }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "byteCount"],
            "properties": {
              "path": { "$ref": "#/$defs/repoPath" },
              "sha256": { "$ref": "#/$defs/prefixedSha256" },
              "byteCount": { "type": "integer", "minimum": 0, "maximum": 67108864 }
            }
          }
        },
        "digest": { "$ref": "#/$defs/prefixedSha256" }
      }
    }
  }
}
