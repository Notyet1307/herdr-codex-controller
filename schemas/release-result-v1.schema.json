{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Release Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "releaseId", "planDigest", "status", "baseSha", "candidateSha", "pullRequest", "requiredChecks", "mergeSha", "completedAt"],
  "properties": {
    "schema": { "const": "herdr-codex-controller:release-result:v1" },
    "releaseId": { "type": "string", "pattern": "^[a-z0-9._-]+$", "minLength": 1, "maxLength": 80 },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "status": { "const": "merged" },
    "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidateSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "pullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "url"],
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "requiredChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names", "status"],
      "properties": {
        "names": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "status": { "const": "passed" }
      }
    },
    "mergeSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "completedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
    "reviewReportDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
