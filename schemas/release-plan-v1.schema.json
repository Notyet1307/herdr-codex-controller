{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Herdr Codex Release Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "objective", "parentIssue", "issues", "releaseAcceptanceCriteria", "reviewFocus"],
  "properties": {
    "version": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "objective": { "type": "string", "minLength": 1, "maxLength": 8000 },
    "parentIssue": { "type": ["integer", "null"], "minimum": 1 },
    "issues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "order", "dependsOn", "objective", "acceptanceCriteria", "suggestedValidation", "allowNoop"],
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "order": { "type": "integer", "minimum": 1 },
          "dependsOn": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
          "objective": { "type": ["string", "null"], "maxLength": 8000 },
          "acceptanceCriteria": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
          "suggestedValidation": { "$ref": "controller-config.schema.json#/$defs/commands" },
          "allowNoop": { "type": "boolean" }
        }
      }
    },
    "releaseAcceptanceCriteria": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "reviewFocus": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } }
  }
}
