{
  "version": 4,
  "repo": "OWNER/REPOSITORY",
  "localPath": "/ABSOLUTE/PATH/TO/LOCAL/CHECKOUT",
  "stateDir": "/ABSOLUTE/PRIVATE/PATH/herdr-codex-state",
  "worktreeRoot": "/ABSOLUTE/PRIVATE/PATH/herdr-codex-worktrees",
  "baseRef": "main",
  "remote": "origin",
  "remoteIdentity": {
    "version": 1,
    "fetchUrl": "https://github.com/OWNER/REPOSITORY.git",
    "pushUrl": "https://github.com/OWNER/REPOSITORY.git"
  },
  "branchPrefix": "agent/release",
  "shell": "/bin/bash",
  "codex": {
    "bin": "/ABSOLUTE/PATH/TO/codex",
    "workerTimeoutMs": 3600000,
    "reviewerTimeoutMs": 1800000,
    "terminationGraceMs": 10000,
    "maxEventBytes": 8388608,
    "maxStderrBytes": 4194304,
    "maxResultBytes": 1048576,
    "maxAggregateBytes": 12582912
  },
  "validation": {
    "setup": [
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm test", "timeoutMs": 2700000 }
    ],
    "issue": [
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm run typecheck", "timeoutMs": 1800000 }
    ],
    "release": [
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm run verify:oracle:o01", "timeoutMs": 1800000 },
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm run typecheck", "timeoutMs": 1800000 },
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm test", "timeoutMs": 2700000 },
      { "command": "npm ci --ignore-scripts --no-audit --no-fund && npm run build", "timeoutMs": 1800000 }
    ],
    "maxOutputBytes": 131072,
    "maxStdoutBytes": 1048576,
    "maxStderrBytes": 1048576,
    "maxAggregateBytes": 2097152,
    "sandbox": {
      "version": 1,
      "provider": "codex-permission-profile",
      "bin": "/ABSOLUTE/PATH/TO/codex",
      "root": "/var/tmp/herdr-codex-validation",
      "environmentPath": ["/usr/local/bin", "/usr/bin", "/bin"]
    }
  },
  "policy": {
    "maxIssueRepairRounds": 1,
    "maxCodeRepairRounds": 1,
    "maxInfrastructureReruns": 1,
    "maxIssues": 8,
    "maxChangedFiles": 50,
    "maxChangedLines": 4000
  },
  "reviewDemo": null,
  "delivery": {
    "draft": false,
    "mergeMethod": "squash",
    "requiredChecks": {
      "version": 1,
      "firstAppearanceTimeoutMs": 300000,
      "pendingTimeoutMs": 3600000,
      "checks": [
        {
          "name": "verify",
          "appId": 15368,
          "workflowName": "CI",
          "acceptedConclusions": ["SUCCESS", "NEUTRAL", "SKIPPED"],
          "required": true
        }
      ]
    },
    "pollIntervalMs": 15000
  }
}
